#!/bin/bash
# Safety guard for `kill`, not the real one. See ./pkill in this same
# directory for the incident this whole guard-bin/ exists for.
#
# Unlike pkill/killall, plain `kill` only ever targets a PID, a process
# group (a negative number), or a job spec (%1) — there is no "kill by
# name" form for it to begin with, so a NUMERIC/job-spec target is let
# through to the real kill (this harness's own cleanup traps rely on
# exactly that: `kill 0` to end the run's whole process group, and a
# script may legitimately `kill` its own child by PID after a timeout —
# see render_resume.py's to_pdf()). What gets refused is anything that
# is NOT a valid numeric/job-spec target — i.e. an attempt to route a
# name through `kill` (the "kill by-name forms" the always-on rules ask
# to cover, so far as `kill`'s own syntax allows: it is a shell BUILTIN in
# bash/zsh/dash, so a plain `kill <name>` typed at an interactive-style
# prompt never reaches this file at all — that path errors out inside the
# builtin itself with "not a pid or valid job spec", never touching a
# process. This shim only ever runs when something bypasses the builtin
# (an explicit `/path/to/kill`, `command kill`, or a subprocess call that
# execs "kill" directly) — real, but a narrower net than pkill/killall's).
set -u

is_flag_only_signal() {
  case "$1" in
    -[0-9]*|-[A-Za-z]*) return 0 ;;   # -9, -TERM, -KILL, ...
    *) return 1 ;;
  esac
}
is_valid_target() {
  case "$1" in
    %*) return 0 ;;                   # job spec — meaningful to the invoking shell only
  esac
  [[ "$1" =~ ^-?[0-9]+$ ]]            # pid or -pid (process group), e.g. 123, -123, 0
}

args=("$@")
i=0
list_mode=0
targets_seen=0
bad=""
while [ "$i" -lt "$#" ]; do
  a="${args[$i]}"
  case "$a" in
    -l|-L) list_mode=1; i=$((i+1)); continue ;;
    -s|--signal) i=$((i+2)); continue ;;   # -s TERM / --signal TERM: skip the signal name too
  esac
  if is_flag_only_signal "$a"; then i=$((i+1)); continue; fi
  # A bare "--" separator, or an empty arg: skip, not a target.
  if [ "$a" = "--" ] || [ -z "$a" ]; then i=$((i+1)); continue; fi
  targets_seen=$((targets_seen+1))
  if ! is_valid_target "$a"; then bad="$a"; fi
  i=$((i+1))
done

if [ -n "$bad" ]; then
  echo "kill is guarded in this test harness (tests/always-on/guard-bin):" >&2
  echo "  refusing target \"$bad\" — it is not a numeric PID/process-group or a" >&2
  echo "  job spec, so this looks like a name routed through kill rather than a" >&2
  echo "  real kill(2) target. This session must not stop a process it did" >&2
  echo "  not itself start — if a step is hung, report it as hung instead" >&2
  echo "  of trying to kill it, by name or by PID." >&2
  exit 1
fi

# list_mode (`kill -l`) never kills anything and has no PID target — let it
# through unconditionally, targets_seen==0 or not.
if [ "$list_mode" = 1 ] && [ "$targets_seen" = 0 ]; then :; fi

REAL_KILL=""
for c in /bin/kill /usr/bin/kill; do
  [ -x "$c" ] && { REAL_KILL="$c"; break; }
done
if [ -z "$REAL_KILL" ]; then
  HERE="$(cd "$(dirname "$0")" && pwd)"
  old_ifs="$IFS"; IFS=:
  for d in $PATH; do
    [ "$d" = "$HERE" ] && continue
    if [ -x "$d/kill" ]; then REAL_KILL="$d/kill"; break; fi
  done
  IFS="$old_ifs"
fi
if [ -z "$REAL_KILL" ]; then
  echo "kill guard: could not find the real kill binary on this system — refusing (fail closed, never fail open)" >&2
  exit 1
fi
exec "$REAL_KILL" "$@"
