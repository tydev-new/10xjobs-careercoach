{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lens-review-v1",
  "title": "One independent lens review of one package (apply/rubric/reviewer-brief.md); merged by finalize_review.py",
  "type": "object",
  "required": [
    "schema",
    "lens",
    "package",
    "reviewer_run_id",
    "rubric_version",
    "reviewed_at",
    "reviewed_files_sha256",
    "verdict",
    "docs",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "lens-review-v1"
    },
    "lens": {
      "enum": [
        "hiring_manager",
        "age_signal_claims",
        "recruiter",
        "ats"
      ]
    },
    "package": {
      "type": "string",
      "minLength": 3
    },
    "reviewer_run_id": {
      "type": "string",
      "minLength": 6
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^apply-rubric-"
    },
    "reviewed_at": {
      "type": "string",
      "minLength": 10
    },
    "reviewed_files_sha256": {
      "type": "object",
      "required": [
        "resume-native.md"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "verdict": {
      "enum": [
        "PASS",
        "REVISE",
        "FAIL"
      ]
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "doc",
          "verdict",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "doc": {
            "enum": [
              "resume",
              "cover"
            ]
          },
          "verdict": {
            "enum": [
              "PASS",
              "REVISE",
              "FAIL"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc",
          "severity",
          "finding",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "doc": {
            "enum": [
              "resume",
              "cover"
            ]
          },
          "severity": {
            "enum": [
              "fail",
              "revise",
              "note"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 8
          },
          "evidence": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "top_rejection_reason": {
      "type": "string",
      "minLength": 8
    },
    "answered": {
      "type": "boolean"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "aliases"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gap_handling": {
      "type": "array",
      "description": "same item shape as review-v1 gap_handling; finalize_review.py validates it against apply/tools/review_schema.json"
    },
    "residual_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}