{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "combined-review-v1",
 "title": "One combined review of one package (rework/reviewer-brief.md, 2026-11-04): one verdict per angle; merged by finalize_review.py",
 "type": "object",
 "required": [
  "schema",
  "package",
  "reviewer_run_id",
  "rubric_version",
  "reviewed_at",
  "reviewed_files_sha256",
  "round",
  "verdict",
  "docs",
  "angles",
  "top_rejection_reason",
  "answered",
  "keywords"
 ],
 "additionalProperties": false,
 "properties": {
  "schema": {
   "const": "combined-review-v1"
  },
  "package": {
   "type": "string",
   "minLength": 3
  },
  "reviewer_run_id": {
   "type": "string",
   "minLength": 6
  },
  "rubric_version": {
   "type": "string",
   "pattern": "^apply-rubric-"
  },
  "reviewed_at": {
   "type": "string",
   "minLength": 10
  },
  "reviewed_files_sha256": {
   "type": "object",
   "required": [
    "resume-native.md"
   ],
   "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   }
  },
  "inputs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "precheck": {
   "type": "string",
   "description": "precheck.py result line the reviewer read (PASS/WARN ...)"
  },
  "round": {
   "type": "integer",
   "minimum": 1,
   "maximum": 10
  },
  "verdict": {
   "enum": [
    "PASS",
    "REVISE",
    "FAIL"
   ]
  },
  "docs": {
   "type": "array",
   "minItems": 1,
   "maxItems": 2,
   "items": {
    "type": "object",
    "required": [
     "doc",
     "verdict",
     "summary"
    ],
    "additionalProperties": false,
    "properties": {
     "doc": {
      "enum": [
       "resume",
       "cover"
      ]
     },
     "verdict": {
      "enum": [
       "PASS",
       "REVISE",
       "FAIL"
      ]
     },
     "summary": {
      "type": "string",
      "minLength": 8
     }
    }
   }
  },
  "angles": {
   "type": "object",
   "required": [
    "hiring_manager",
    "recruiter",
    "ats",
    "age_signal_claims"
   ],
   "additionalProperties": false,
   "properties": {
    "hiring_manager": {
     "type": "object",
     "required": [
      "verdict",
      "summary",
      "findings"
     ],
     "additionalProperties": false,
     "properties": {
      "verdict": {
       "enum": [
        "PASS",
        "REVISE",
        "FAIL"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 8
      },
      "findings": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "doc",
         "severity",
         "finding",
         "evidence"
        ],
        "additionalProperties": false,
        "properties": {
         "doc": {
          "enum": [
           "resume",
           "cover"
          ]
         },
         "severity": {
          "enum": [
           "fail",
           "revise",
           "note"
          ]
         },
         "finding": {
          "type": "string",
          "minLength": 8
         },
         "evidence": {
          "type": "string",
          "minLength": 4
         }
        }
       }
      }
     }
    },
    "recruiter": {
     "type": "object",
     "required": [
      "verdict",
      "summary",
      "findings"
     ],
     "additionalProperties": false,
     "properties": {
      "verdict": {
       "enum": [
        "PASS",
        "REVISE",
        "FAIL"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 8
      },
      "findings": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "doc",
         "severity",
         "finding",
         "evidence"
        ],
        "additionalProperties": false,
        "properties": {
         "doc": {
          "enum": [
           "resume",
           "cover"
          ]
         },
         "severity": {
          "enum": [
           "fail",
           "revise",
           "note"
          ]
         },
         "finding": {
          "type": "string",
          "minLength": 8
         },
         "evidence": {
          "type": "string",
          "minLength": 4
         }
        }
       }
      }
     }
    },
    "ats": {
     "type": "object",
     "required": [
      "verdict",
      "summary",
      "findings"
     ],
     "additionalProperties": false,
     "properties": {
      "verdict": {
       "enum": [
        "PASS",
        "REVISE",
        "FAIL"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 8
      },
      "findings": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "doc",
         "severity",
         "finding",
         "evidence"
        ],
        "additionalProperties": false,
        "properties": {
         "doc": {
          "enum": [
           "resume",
           "cover"
          ]
         },
         "severity": {
          "enum": [
           "fail",
           "revise",
           "note"
          ]
         },
         "finding": {
          "type": "string",
          "minLength": 8
         },
         "evidence": {
          "type": "string",
          "minLength": 4
         }
        }
       }
      }
     }
    },
    "age_signal_claims": {
     "type": "object",
     "required": [
      "verdict",
      "summary",
      "findings"
     ],
     "additionalProperties": false,
     "properties": {
      "verdict": {
       "enum": [
        "PASS",
        "REVISE",
        "FAIL"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 8
      },
      "findings": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "doc",
         "severity",
         "finding",
         "evidence"
        ],
        "additionalProperties": false,
        "properties": {
         "doc": {
          "enum": [
           "resume",
           "cover"
          ]
         },
         "severity": {
          "enum": [
           "fail",
           "revise",
           "note"
          ]
         },
         "finding": {
          "type": "string",
          "minLength": 8
         },
         "evidence": {
          "type": "string",
          "minLength": 4
         }
        }
       }
      }
     }
    }
   }
  },
  "top_rejection_reason": {
   "type": "string",
   "minLength": 8
  },
  "answered": {
   "type": "boolean"
  },
  "keywords": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "term",
     "aliases"
    ],
    "additionalProperties": false,
    "properties": {
     "term": {
      "type": "string",
      "minLength": 1
     },
     "aliases": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "gap_handling": {
   "type": "array",
   "description": "review-v1 gap_handling item shape; validated against tools/review_schema.json"
  },
  "residual_gaps": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "user_ok": {
   "type": "string",
   "minLength": 8,
   "description": "A round requiring escalation beyond the configured free-round/wording-only policy: genuine current-user approval reference"
  },
  "precheck_warns": {
   "type": "array",
   "description": "2026-11-04b: one entry per precheck.py WARN (id W-xxxxxx from precheck.json info.warn_ids): accepted with a one-line reason, or fixed (then precheck re-run)",
   "items": {
    "type": "object",
    "required": [
     "id",
     "action",
     "reason"
    ],
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^W-[0-9a-f]{6}$"
     },
     "warn": {
      "type": "string"
     },
     "action": {
      "enum": [
       "accepted",
       "fixed"
      ]
     },
     "reason": {
      "type": "string",
      "minLength": 8
     }
    }
   }
  },
  "best_candidate": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "description": "Workflow rule question #1: the JD's top 3-5 asks, the user's strongest confirmed proof for each, and where it sits on the resume. Required by finalize for new reviews; optional in the schema so old reviews stay readable.",
   "items": {
    "type": "object",
    "required": [
     "ask",
     "proof_claim_ids",
     "on_resume",
     "suggested_line"
    ],
    "additionalProperties": false,
    "properties": {
     "ask": {
      "type": "string",
      "minLength": 4
     },
     "proof_claim_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "on_resume": {
      "enum": [
       "yes",
       "buried",
       "understated",
       "missing"
      ]
     },
     "evidence": {
      "type": "string"
     },
     "suggested_line": {
      "type": [
       "string",
       "null"
      ]
     },
     "question_for_user": {
      "type": "string"
     }
    }
   }
  },
  "rejection_reasons": {
   "type": "array",
   "minItems": 1,
   "maxItems": 5,
   "description": "Workflow rule: likely screen-out reasons, each with exactly one outcome. Required by finalize for new reviews; optional in the schema so old reviews still load.",
   "items": {
    "type": "object",
    "required": [
     "reason",
     "outcome"
    ],
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string",
      "minLength": 8
     },
     "outcome": {
      "enum": [
       "fixed",
       "cant_fix",
       "not_a_risk"
      ]
     },
     "proof_claim_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "suggested_line": {
      "type": "string",
      "minLength": 8
     },
     "question_for_user": {
      "type": "string",
      "minLength": 8
     },
     "screen_out_note": {
      "type": "string",
      "minLength": 8
     },
     "reason_not_risk": {
      "type": "string",
      "minLength": 8
     }
    }
   }
  }
 }
}
