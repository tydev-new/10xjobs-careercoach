#!/usr/bin/env python3
"""Harness-owned stand-in for headless Chrome — never launches a real
browser. tests/always-on/lib_env.sh points RENDER_RESUME_CHROME at this
file for every runner, and skills/apply/scripts/render_resume.py's to_pdf()
reads that var when its caller does not pass an explicit `chrome=`.

Why this exists (owner ruling 2026-09-26, replacing an earlier plan to run
the whole harness as a separate macOS user): the PDF step used to launch
REAL headless Chrome even inside a test session. That is what hung during
the 2026-09-26 incident (skills/apply/scripts/render_resume.py's docstring,
tests/always-on/guard-bin/pkill) — an agent under test then tried to
unblock itself with `pkill -f "Google Chrome"`, killing every Chrome
process on the machine, including the owner's own open browser. The fix
here is simpler than isolating the OS user: give a harness run no real
browser to hang in the first place. This script writes a small, valid,
realistically-sized PDF immediately and exits 0 — there is nothing for a
test session to "fix".

Invoked with the exact same argv shape to_pdf() gives real Chrome:
    fake-chrome --headless --disable-gpu --no-pdf-header-footer
                --user-data-dir=<tmp> --print-to-pdf=<pdf_path> <html_path>
Only --print-to-pdf=<path> is read; everything else is accepted and
ignored, same as a real headless Chrome would accept flags this script
doesn't care about.

Size is realistic-but-fixed, not derived from the source HTML — this is a
stand-in, not a renderer, so a page-count claim would not be honest either.
FAKE_CHROME_PDF_BYTES overrides the size for a case that specifically wants
to exercise render_resume.py's "over the ~100KB upload limit" line.
"""
import os
import sys

DEFAULT_SIZE = 45_000  # a realistic single/two-page résumé PDF, in bytes

# A minimal, valid one-page PDF. pdf_pages() (render_resume.py) counts raw
# occurrences of b"/Type /Page" minus b"/Type /Pages" — the spacing here
# matches that exactly, so this reports as a real 1-page PDF, not zero.
_HEADER = b"%PDF-1.4\n"
_BODY = (
    b"1 0 obj<</Type /Catalog/Pages 2 0 R>>endobj\n"
    b"2 0 obj<</Type /Pages/Kids[3 0 R]/Count 1>>endobj\n"
    b"3 0 obj<</Type /Page/Parent 2 0 R/MediaBox[0 0 612 792]>>endobj\n"
    b"trailer<</Root 1 0 R>>\n"
    b"%%EOF\n"
)


def build_pdf_bytes(size):
    """A valid PDF (header, three objects, trailer) padded to `size` bytes
    with a PDF comment line (a '%'-leading line) — comments are inert to any
    parser, so padding changes the file's size without disturbing the
    object structure pdf_pages() scans."""
    base = _HEADER + _BODY
    pad_needed = size - len(base)
    if pad_needed <= 0:
        return base
    # "%" + filler + "\n", so it stays a single well-formed comment line
    padding = b"%" + (b"0" * (pad_needed - 2)) + b"\n"
    return _HEADER + padding + _BODY


def main(argv):
    pdf_path = None
    for a in argv:
        if a.startswith("--print-to-pdf="):
            pdf_path = a.split("=", 1)[1]
    if not pdf_path:
        print("fake-chrome: no --print-to-pdf=<path> in argv — nothing to write",
              file=sys.stderr)
        return 1
    size = int(os.environ.get("FAKE_CHROME_PDF_BYTES", DEFAULT_SIZE))
    with open(pdf_path, "wb") as f:
        f.write(build_pdf_bytes(size))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
